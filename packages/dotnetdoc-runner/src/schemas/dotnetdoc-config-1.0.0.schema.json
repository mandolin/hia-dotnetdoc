{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandolin.github.io/HIA-Documentation/schemas/dotnetdoc-config-1.0.0.schema.json",
  "$comment": "中文：当前配置保留目录省略默认、要求显式输入kind并拒绝null；验证不授权执行。 English: Current config retains omission defaults, requires explicit input kinds and rejects null; validation grants no execution permission.",
  "title": "DotNetDoc Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inputs"
  ],
  "properties": {
    "$schema": {
      "const": "https://mandolin.github.io/HIA-Documentation/schemas/dotnetdoc-config-1.0.0.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"
          },
          {
            "pattern": ":"
          },
          {
            "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
          }
        ]
      }
    },
    "outputDirectory": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"
          },
          {
            "pattern": ":"
          },
          {
            "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
          }
        ]
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "anyOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "paths"
            ]
          },
          {
            "required": [
              "projectPath"
            ]
          },
          {
            "required": [
              "glob"
            ]
          },
          {
            "required": [
              "globs"
            ]
          }
        ],
        "properties": {
          "kind": {
            "enum": [
              "dotnet-xml-doc",
              "dotnet-csharp-source",
              "dotnet-aspnet-surface",
              "dotnet-markup-comments",
              "dotnet-project"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "not": {
              "anyOf": [
                {
                  "pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"
                },
                {
                  "pattern": ":"
                },
                {
                  "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
                }
              ]
            }
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "not": {
                "anyOf": [
                  {
                    "pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"
                  },
                  {
                    "pattern": ":"
                  },
                  {
                    "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
                  }
                ]
              }
            }
          },
          "projectPath": {
            "type": "string",
            "minLength": 1,
            "not": {
              "anyOf": [
                {
                  "pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"
                },
                {
                  "pattern": ":"
                },
                {
                  "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
                }
              ]
            }
          },
          "glob": {
            "type": "string",
            "minLength": 1,
            "not": {
              "anyOf": [
                {
                  "pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"
                },
                {
                  "pattern": ":"
                },
                {
                  "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
                }
              ]
            }
          },
          "globs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "not": {
                "anyOf": [
                  {
                    "pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"
                  },
                  {
                    "pattern": ":"
                  },
                  {
                    "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
                  }
                ]
              }
            }
          },
          "excludeGlobs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "not": {
                "anyOf": [
                  {
                    "pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"
                  },
                  {
                    "pattern": ":"
                  },
                  {
                    "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
                  }
                ]
              }
            }
          },
          "applicationRoot": {
            "type": "string",
            "minLength": 1,
            "not": {
              "anyOf": [
                {
                  "pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"
                },
                {
                  "pattern": ":"
                },
                {
                  "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
                }
              ]
            }
          },
          "artifactBasePath": {
            "type": "string",
            "minLength": 1,
            "not": {
              "anyOf": [
                {
                  "pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"
                },
                {
                  "pattern": ":"
                },
                {
                  "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
                }
              ]
            }
          },
          "hiaDocumentId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "writeResultManifest": {
          "type": "boolean"
        },
        "writeSourceRelationArtifact": {
          "type": "boolean"
        },
        "writeDocSourceMapArtifact": {
          "type": "boolean"
        }
      }
    },
    "profileIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    }
  }
}
