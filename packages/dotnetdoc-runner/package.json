{
  "name": "@hia-doc/dotnetdoc-runner",
  "version": "0.1.1",
  "description": "Standalone .NET XML documentation runner and CLI.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "hia",
    "dotnetdoc",
    "dotnet",
    "csharp",
    "documentation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandolin/hia-dotnetdoc.git",
    "directory": "packages/dotnetdoc-runner"
  },
  "bugs": {
    "url": "https://github.com/mandolin/hia-dotnetdoc/issues"
  },
  "homepage": "https://github.com/mandolin/hia-dotnetdoc/tree/main/packages/dotnetdoc-runner#readme",
  "exports": {
    ".": "./src/index.mjs"
  },
  "bin": {
    "hia-dotnetdoc": "src/cli.mjs",
    "dotnetdoc": "src/cli.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@hia-doc/dotnet-source-extractor": "0.1.1",
    "@hia-doc/dotnet-xml-doc-extractor": "0.1.1",
    "@hia-doc/dotnetdoc-adapter": "0.1.1",
    "@hia-doc/dotnetdoc-spec": "0.1.1"
  }
}
