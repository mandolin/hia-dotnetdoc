{
  "name": "@hia-doc/dotnet-xml-doc-extractor",
  "version": "1.0.0",
  "description": "Parse compiler XML documentation files into DotNetDoc extraction artifacts.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "keywords": [
    "hia",
    "dotnetdoc",
    "dotnet",
    "xml-docs",
    "documentation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandolin/hia-dotnetdoc.git",
    "directory": "packages/dotnet-xml-doc-extractor"
  },
  "bugs": {
    "url": "https://github.com/mandolin/hia-dotnetdoc/issues"
  },
  "homepage": "https://github.com/mandolin/hia-dotnetdoc/tree/main/packages/dotnet-xml-doc-extractor#readme",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "API.md",
    "MIGRATION.md"
  ],
  "dependencies": {
    "@hia-doc/dotnetdoc-spec": "1.0.0",
    "fast-xml-parser": "5.3.2"
  },
  "types": "./src/index.d.mts"
}
