{
  "name": "@hia-doc/dotnet-source-extractor",
  "version": "1.0.0",
  "description": "Parse C# source files into DotNetDoc extraction artifacts through a Roslyn helper.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "keywords": [
    "hia",
    "dotnetdoc",
    "csharp",
    "roslyn",
    "documentation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandolin/hia-dotnetdoc.git",
    "directory": "packages/dotnet-source-extractor"
  },
  "bugs": {
    "url": "https://github.com/mandolin/hia-dotnetdoc/issues"
  },
  "homepage": "https://github.com/mandolin/hia-dotnetdoc/tree/main/packages/dotnet-source-extractor#readme",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "src",
    "global.json",
    "tools/DotNetDoc.RoslynSourceExtractor/DotNetDoc.RoslynSourceExtractor.csproj",
    "tools/DotNetDoc.RoslynSourceExtractor/Program.cs",
    "README.md",
    "LICENSE",
    "API.md",
    "MIGRATION.md"
  ],
  "dependencies": {
    "@hia-doc/dotnet-xml-doc-extractor": "1.0.0",
    "@hia-doc/dotnetdoc-spec": "1.0.0",
    "fast-xml-parser": "5.3.2"
  },
  "types": "./src/index.d.mts"
}
